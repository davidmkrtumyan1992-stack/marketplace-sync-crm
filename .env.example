# Окружение
NODE_ENV=production
PORT=3000

# База данных PostgreSQL
DATABASE_URL=postgresql://crm_user:PASSWORD@HOST:5432/crm

# Секрет для сессий (случайная строка 64+ символа)
SESSION_SECRET=замените-на-случайную-строку-минимум-64-символа

# API ключи маркетплейсов (берутся из Replit Secrets)
# Ozon
OZON_CLIENT_ID_1=
OZON_API_KEY_1=

# Wildberries
WB_API_KEY=

# Яндекс Маркет
YM_API_KEY=
